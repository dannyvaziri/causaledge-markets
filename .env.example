# Personal dashboard access. Use a long random value in Hostinger.
DASHBOARD_TOKEN=

# Secret used by the Hostinger cron job to run autonomous paper cycles.
ENGINE_SECRET=

# $100 -> $1,000 challenge settings
CHALLENGE_START=100
CHALLENGE_TARGET=1000
CHALLENGE_WATCHLIST=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD,JPM,SPY

# Execution locks. These affect PAPER trading only.
PAPER_EXECUTION_ENABLED=false
AUTO_EXECUTION_ENABLED=false
TRADING_KILL_SWITCH=false

# Alpaca PAPER credentials. Never commit actual values.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# AI catalyst classifier
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Legacy OAuth settings retained for older API routes; not required by the new personal dashboard.
APP_URL=https://your-hostinger-domain.example
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
