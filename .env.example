# Hostinger production URL
APP_URL=https://darkviolet-ibis-337737.hostingersite.com

# Site authentication
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAILS=
DASHBOARD_TOKEN=

# Protected engine scheduling
ENGINE_SECRET=
CRON_SECRET=

# Paper challenge settings
CHALLENGE_START=100
CHALLENGE_TARGET=1000
CHALLENGE_WATCHLIST=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD,JPM,SPY

# Safe execution defaults
PAPER_EXECUTION_ENABLED=false
AUTO_EXECUTION_ENABLED=false
TRADING_KILL_SWITCH=true
LIVE_TRADING_ENABLED=false

# Alpaca PAPER credentials. Never commit actual values.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional legacy Alpaca paper OAuth routes
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=

# AI provider. Groq is preferred when GROQ_API_KEY is present.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Live credentials remain blank while live trading is disabled.
LIVE_ALPACA_API_KEY=
LIVE_ALPACA_API_SECRET=

# Supabase execution audit database (server-side only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
